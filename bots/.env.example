# Perps: the single settings template. Copy to bots/.env and fill in.
# The console (python bots/perps_ui.py: Settings, Brain Setup) writes the same file.
#
# Rules: never commit bots/.env. Values here are blank or defaults; no real keys, IDs or handles.
# Lines that start with "# KEY=" are optional knobs shown with their built-in default:
# remove the "# " to change one. Active lines below already equal the built-in default.
# Blank optional keys ship commented out: a KEY= line with no value is treated as unset (built-in default) anyway.
# Prices for the services below: SETUP.md section 0.1.

# ===== Paths =====
# repo root; blank = the folder that contains bots/. Sign up: none
# WORKSPACE_DIR=

# ===== Paper mode (start here) =====
# true = paper mode: fills simulate at the oracle price, positions and P/L go to bot_logs/paper_*.json,
# stop/TP protection runs, and nothing is ever signed or sent. No wallet key needed.
# Run at least one full trade in paper mode, then set false to go live. Restart Perps after changing.
PERPS_DRY_RUN=true

# ===== Trading wallet (required) =====
# Make a NEW burner wallet in any Solana wallet app and export its private key. Fund it only with what you can lose.
# base58 private key of the burner trading wallet. Sign up: none, create it in a Solana wallet app
PRIVATE_KEY=
# WALLET_ADDRESS=  # public address of that wallet (warden cross-checks). Optional. Sign up: none

# ===== RPC (required) =====
# Sign up at https://www.helius.dev (free tier to start) or use any Solana RPC provider.
# Solana RPC URL, e.g. https://mainnet.helius-rpc.com/?api-key=<key>. Sign up: helius.dev or any RPC provider
RPC_URL=
# Helius key for the warden's enhanced APIs; optional. Sign up: helius.dev dashboard
# HELIUS_API_KEY=
# RPC_PUBLIC_FALLBACK=https://api.mainnet-beta.solana.com  # free public mainnet RPC, warden last resort. No sign-up
# Helius plan -> daily credit cap (the setup wizard asks your plan and sets this; SETUP.md 0.2).
# Free (1M/mo) 30000 | Developer ($49, 10M) 300000 | Business ($499, 100M) 3000000 | any number | 0 = off (no protection).
# Unset = Free cap 30000. Near the cap background reads slow down; trades, closes and the position monitor never do.
# HELIUS_DAILY_CREDIT_CAP=
# HELIUS_CAP_MODE=soft  # soft (restrict at SOFT_PCT) | hard (restrict at 100%) | log (count only)
# HELIUS_SOFT_CAP_PCT=80  # percent of the cap where soft mode starts restricting
# PERP_MARK_CACHE_S=20  # one mark-price cache shared by the position monitor, owner loop and limit watcher (15-30s)
# PERP_MARK_CACHE_CAPPED_S=120  # background mark-price cache age while the cap is restricting (the monitor stays fresh)

# ===== Brain / models (optional; Grok recommended) =====
# Main and fallback brain: grok | ollama | off. Only these two run; the engine and every sub-bot follow them.
# Both off = no SI calls: summaries blank, directives need exact form ("set PARAM VALUE"), trading unaffected.
LLM_MAIN=grok
LLM_FALLBACK=ollama
# Grok (xAI) key; blank = Grok skipped. Sign up: https://console.x.ai
# GROK_API_KEY=
# XAI_API_KEY=  # alias for GROK_API_KEY. Leave unset
# Grok text model: auto = the built-in newest-first list, or pin one (e.g. grok-4.7)
GROK_TEXT_MODEL=auto
# security warden's Grok model; unset = GROK_TEXT_MODEL when pinned, else grok-4.7
# XAI_MODEL=
# local Ollama daemon; not running = Ollama skipped. Sign up: none, install from https://ollama.com
OLLAMA_URL=http://localhost:11434
# local Ollama text model (ollama pull qwen3:14b-q4_K_M)
OLLAMA_MODEL=qwen3:14b-q4_K_M
# overseer (agent_autoagent) model overrides; blank = defaults
# OVERSEER_GROK_MODEL=
# OVERSEER_FALLBACK_MODEL=
# Ollama address used by code_tuner; set it to match OLLAMA_URL if Ollama is not on this machine
# OLLAMA_HOST=http://127.0.0.1:11434

# Jupiter API key (x-api-key) for the swap API that funds shorts. Optional: blank = keyless api.jup.ag at a low rate limit.
# Trading (open/adjust/close) is on-chain through RPC_URL and needs no Jupiter key. Sign up: https://developers.jup.ag/portal
# JUPITER_API_KEY=

# Editor the console opens for edits; blank = notepad (Windows) or nano
# EDITOR=

# ===== Feeds (Flow + live odds + news; no keys needed) =====
# Flow public data base URL (the bot reads only a fixed list of files under it). No sign-up
FLOW_BASE_URL=https://theflowcycle.com/data
# Upstream file prefix for Flow's two editorial files (<prefix>_thesis, mechanical_vs_<prefix>).
# Blank (default) = skip those two files; the rest of the Flow feed works without them.
# To read them, set the prefix your FLOW_BASE_URL uses for its editorial files (see that feed's file list).
FLOW_EDITOR_PREFIX=
# manual = pull Flow/news only when the agent asks (json_relay/feed_request.json). Or a number of minutes.
# Odds are never on a cadence: they are fetched live at every packet / decision.
FEED_CADENCE=manual
# Flow / news data older than this (minutes) is flagged stale (kept, not dropped)
FLOW_STALE_MIN=120
NEWS_STALE_MIN=180
# failover: a source is down after this many failures in a row; retry the primary after N min
FEED_FAIL_LIMIT=2
FEED_FAILBACK_COOLDOWN_MIN=10
# Google News RSS: ';'-separated queries; blank = built-in crypto/macro list
# NEWS_QUERIES=
NEWS_MAX_AGE_H=48
# Polymarket filters
POLY_MIN_LIQUIDITY_USD=5000
POLY_MOVER_MIN_SHIFT=0.10
# Kalshi end-of-day ladder close hour (ET)
KALSHI_DAILY_CLOSE_HOUR_ET=17
# Google News RSS endpoint and how many headlines to keep per pull
# NEWS_RSS_URL=https://news.google.com/rss/search
# NEWS_MAX_ITEMS=40
# Kalshi market data needs no key. Optional slots, unused today.
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=

# ===== Macro prints (released CPI numbers in every packet; optional keys) =====
# Flow's FRED fields are used first. CPI components come from the BLS public API (keyless v1,
# 25 requests/day per IP). Optional free BLS key (v2, higher limit): https://data.bls.gov/registrationEngine/
# BLS_API_KEY=
# Optional FRED fallback when BLS refuses (free key: https://fred.stlouisfed.org/docs/api/api_key.html)
# FRED_API_KEY=
# Max BLS/FRED fetch attempts per ET day, and release-morning re-check interval (minutes)
# MACRO_BLS_DAILY_MAX=12
# MACRO_RELEASE_RECHECK_MIN=20

# ===== Alerts (optional) =====
# Telegram bot token from @BotFather and your chat ID; blank = no alerts. Sign up: Telegram @BotFather
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=
# WARDEN_TELEGRAM_TOKEN=  # separate bot for warden alerts; unset = TELEGRAM_TOKEN
# PERPS_WATCH_TELEGRAM_TOKEN=  # separate bot for the heartbeat watchdog; unset = TELEGRAM_TOKEN

# ===== Trading =====
# Switches (also in the setup wizard and the tuner; a saved tuner default wins over these):
# NEW_POSITIONS_ENABLED=false declines every long/short/add the agent sends (reason new_positions_off);
#   closes, adjust, update_params, close_pct and pull_initial still work. The bot never trades on its own.
# ENTRY_ALERTS_ENABLED=false mutes the intel scanner's entry alerts only.
# (AUTO_TRADE_ENABLED is deprecated: when the two keys above are unset it sets both.)
# NEW_POSITIONS_ENABLED=true
# ENTRY_ALERTS_ENABLED=true
# price poll for open positions, seconds (default 30)
# PERP_POLL_SECONDS=30
# parked limit entries (limit_long / limit_short): hours before an unfilled one expires (default 24)
# PERP_LIMIT_TTL_HOURS=24
# trade autopsy ("what went wrong", one review per closed trade -> bot_logs/perp_trade_autopsies.jsonl,
# an inbox packet and one learnings entry; never changes params). loss (default) | all | off
# AUTOPSY_ON=loss
# use the SI brain (LLM_MAIN / LLM_FALLBACK) for the review; false = rule-based only
# AUTOPSY_SI_ENABLED=true
# cost guard: SI reviews per day, then rule-based (default 6)
# AUTOPSY_SI_MAX_PER_DAY=6
# trail alert: arms at this PnL % on collateral (margin/ROE, NET of fees and borrow), fires on this many
# points of giveback from the peak (alerts only, never closes). These are the values AT 5x.
# PERP_TRAIL_ACTIVATE=20
# PERP_TRAIL_DROP=15
# trail scaling by leverage, relative to PERP_TRAIL_REF_LEVERAGE (5x keeps 20/15 exactly; never below the base):
#   sqrt (default): x sqrt(lev/5) -> 20x: arm 40 / giveback 30 (2.0% / 1.5% price); 50x: arm 63 / giveback 47 (1.3% / 0.95% price)
#   linear: same price move at every leverage (arm 4% / giveback 3% price); off: fixed 20/15 margin at every leverage
# giveback is capped at 50 margin points. A per-position trail_activate_pct / trail_drop_pct (update_params) is used as given.
# PERP_TRAIL_LEV_SCALE=sqrt
# PERP_TRAIL_REF_LEVERAGE=5
# size (USD notional) and leverage the intel scanner uses in its entry suggestions; AUTO_LEVERAGE is also the
# fallback leverage for a position record that has none. Suggestions only: the agent sizes every real signal.
# PERP_AUTO_SIZE_USD=150
# PERP_AUTO_LEVERAGE=5
# leftover position value under this (USD) is treated as dust
# PERP_RESIDUAL_DUST_USD=

# ===== Owner positions (positions the bot did not open) =====
# true = ask before managing a position or add the bot did not place
# OWNER_POS_ENABLED=
# minutes to wait for /manage or /leave
# OWNER_POS_TIMEOUT_MIN=
# step in when price is inside this fraction of the entry-to-liq distance (0.15 = 15%)
# OWNER_POS_LIQ_EARLY_FRAC=
# seconds between on-chain scans
# OWNER_POS_SCAN_S=

# ===== Owner commands (optional, off by default) =====
# /manage, /leave, /roast, /recap, /autopsy.  off | telegram | file  (SETUP.md section 6.5)
OWNER_COMMANDS=off
# a SEPARATE command bot (never TELEGRAM_TOKEN). Sign up: Telegram @BotFather
# OWNER_COMMANDS_TG_TOKEN=
# blank = TELEGRAM_CHAT_ID
# OWNER_COMMANDS_TG_CHAT_ID=
# OWNER_ROAST_COOLDOWN_S=900  # shared cooldown for /roast and /recap

# ===== Supervisor and console =====
# PERPS_COMPONENTS=  # comma list of sub-bots perps.py starts (security_warden,agent_autoagent,code_tuner,owner_commands); unset = all
# PERPS_UI=1  # 0 = no console in the engine window

# Leverage: your cap (10-250x) and the ladder used when a signal omits leverage (collateral_sol:leverage; less collateral = more leverage)
PERP_MAX_LEVERAGE=20
PERP_LEV_LADDER=0.1:20,1:15,10:12,50:10
# Optional cap on collateral per position, in SOL (size cap = this x PERP_MAX_LEVERAGE). Blank or 0 = no extra cap beyond the wallet and risk rules
# PERP_MAX_COLLATERAL_SOL=

# One position per market. true = a long blocks a short on the same market (close it first).
# false (default) = whatever Jupiter allows: long and short on one market as separate positions.
# A same-side re-open is always action=add.
PERP_ONE_PER_MARKET=false

# Liquidation / SL warnings: sent ONCE per position (remembered across reboots), only
# when price is within this % of liq / of the SL.
PERP_LIQ_WARN_PCT=5
PERP_SL_WARN_PCT=0.5
# refuse opens/adds while the position monitor (the only TP/SL watcher) is not ticking (1 = on, 0 = off)
# PERP_OPEN_REQUIRE_MONITOR=1
# seconds without a monitor tick before opens are refused
# PERP_MONITOR_STALE_S=180
# refuse an add whose estimated liquidation would sit within this % of the stop (0 = off)
# PERP_ADD_MIN_SL_LIQ_GAP_PCT=3
# warn (never block) at open when the SL sits past this fraction of the entry-to-liquidation distance (0 = off)
# PERP_SL_LIQ_WARN_FRAC=0.6

# ===== Names (optional) =====
# Filled into learnings/LEARNINGS.md ({AGENT_NAME}, {USER}) when learnings_writer creates it from the template.
# AGENT_NAME=
# OWNER_NAME=
